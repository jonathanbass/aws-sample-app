<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Versions live here and nowhere else. Project files reference packages
       without a Version attribute.

       Package versions are added by the phase that first needs them, so this
       stays honest about what is actually in use:
         Phase 2  AWSSDK.DynamoDBv2, Amazon.Lambda.Core,
                  Amazon.Lambda.APIGatewayEvents, Amazon.Lambda.RuntimeSupport
         Phase 3  AWSSDK.SQS, Amazon.Lambda.DynamoDBEvents
         Phase 5  AWSSDK.ApiGatewayManagementApi, Amazon.Lambda.SQSEvents
         Tests    xunit.v3, NSubstitute, AwesomeAssertions,
                  Microsoft.NET.Test.Sdk
  -->
  <ItemGroup Label="Lambda runtime">
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageVersion Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.2.1" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.DynamoDBEvents" Version="4.0.0" />
    <PackageVersion Include="Amazon.Lambda.SQSEvents" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup Label="AWS SDK">
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.103.8" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.14" />
    <PackageVersion Include="AWSSDK.ApiGatewayManagementApi" Version="4.0.100.15" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

</Project>
