<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> drops the machine-level sources inherited from
       %AppData%\NuGet\NuGet.Config. This is a personal project: it must not
       resolve packages from work feeds, and central package management
       requires a single source (or explicit source mapping) anyway. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
